# ─── Variables de entorno para la demo OWASP ──────────────────────────────────
# Copiá este archivo como ".env" y completá los valores reales.
# Nunca subas el .env real al repositorio (ya está en .gitignore).

# Clave secreta para firmar los tokens JWT.
# Usá una cadena larga y aleatoria en producción.
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Puerto donde escucha la app segura (opcional, por defecto 3001)
PORT=3001
